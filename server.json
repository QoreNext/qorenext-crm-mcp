{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.QoreNext/qorenext-crm-mcp",
  "title": "QoreNext CRM",
  "description": "Company hierarchy, address verification and CRM duplicate detection via MCP",
  "version": "1.0.2",
  "websiteUrl": "https://qorenext.com",
  "repository": {
    "url": "https://github.com/QoreNext/qorenext-crm-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.qorenext.com/crm",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "QoreNext API key: Profile > APIs at https://qorenext-app.azurewebsites.net/signup",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "tools": [
        "health_check",
        "submit_address_verification",
        "submit_hierarchy_creation",
        "submit_duplicates",
        "get_request_status"
      ],
      "categories": ["verification", "hierarchy", "company-data", "deduplication"],
      "license": "MIT",
      "contact": "support@qorenext.com"
    }
  }
}
